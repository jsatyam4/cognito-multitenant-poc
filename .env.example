# Copy to .env (gitignored) and fill in. Scripts and the API load it automatically; values are never printed.

# --- AWS credentials for the POC account
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Account guard: every script that creates or deletes resources refuses to run
#     unless the credentials above belong to this 12-digit account ID
AWS_ACCOUNT_ID=

# --- Password given to every seeded demo user (npm run seed)
#     At least 10 characters with upper and lower case, a number and a symbol
DEMO_PASSWORD=

# --- Optional: push this repo to GitHub using a token instead of the keychain
#     (wired up with the repo-local git credential helper described in README.md)
# GITHUB_USER=
# GITHUB_TOKEN=
